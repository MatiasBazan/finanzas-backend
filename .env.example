# Entorno
NODE_ENV=production
PORT=3000

# Base de Datos (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=finanzas
DB_PASSWORD=cambiame
DB_NAME=finanzas

# JWT — minimo 32 chars. Generar: openssl rand -hex 32
JWT_SECRET=cambia_esto_por_un_string_largo_y_aleatorio_min_32
JWT_EXPIRES_IN=7d

# Frontend (CORS)
FRONTEND_URL=https://tu-frontend.com

# Twilio (opcional — si falta, notificaciones WhatsApp quedan deshabilitadas)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
